{
  "productName": "Papery 阅读器",
  "version": "0.1.8",
  "identifier": "com.papery.reader",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node scripts/tauri-before-build.mjs",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Papery 阅读器",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com; worker-src 'self' blob:; font-src 'self' data: blob:; connect-src 'self' blob: data: ipc: http://ipc.localhost https:; child-src 'self' blob:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "papery"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "papery"
          ],
          "appLink": false
        }
      ]
    }
  }
}
