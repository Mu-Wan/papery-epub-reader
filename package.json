{
  "name": "papery-reader",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/vendor",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "tauri": "tauri",
    "tauri:dev": "cross-env TAURI_BUILD=1 node scripts/copy-vendor.mjs && cross-env TAURI_BUILD=1 next dev",
    "tauri:build": "node scripts/tauri-build.mjs"
  },
  "dependencies": {
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "drizzle-orm": "0.45.2",
    "epubjs": "^0.3.93",
    "foliate-js": "1.0.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^7.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Papery 阅读器"
}
